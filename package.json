{
  "name": "quoridor-ai",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "test": "node --test",
    "benchmark": "node scripts/benchmark.mjs",
    "evaluate": "node scripts/evaluate.mjs",
    "analyze-losses": "node scripts/analyze-losses.mjs",
    "wasm:build": "node scripts/build-wasm.mjs",
    "external:setup": "node scripts/setup-external.mjs",
    "train": "python training/train.py",
    "train:test": "python -m unittest discover -s training -p test_*.py",
    "model:export": "python training/export.py",
    "dev:web": "vite --host 127.0.0.1",
    "native:build": "node scripts/build-native.mjs",
    "native:serve": "node server/native-service.mjs",
    "native:review": "node scripts/review-native-losses.mjs",
    "native:evaluate": "node scripts/evaluate-native.mjs",
    "native:promote": "node scripts/promote-native.mjs",
    "native:verify": "node scripts/verify-native.mjs",
    "selfplay:gpu": "node scripts/gpu-selfplay.mjs",
    "selfplay:cpu": "python training/batch_selfplay.py --device cpu",
    "train:cnn": "node scripts/train-cnn.mjs",
    "neural:league": "node scripts/neural-league.mjs",
    "train:teacher": "node scripts/train-teacher.mjs",
    "native:diagnose": "node scripts/diagnose-native.mjs",
    "maze:build": "node scripts/build-maze.mjs",
    "maze:evaluate": "node scripts/evaluate-maze.mjs",
    "maze:ablate": "node scripts/ablate-maze.mjs",
    "maze:assess": "node scripts/assess-maze.mjs",
    "maze:compare-search": "node scripts/compare-search.mjs",
    "maze:check-geometry": "node scripts/check-wall-geometry.mjs",
    "maze:compare-geometry": "node scripts/compare-geometry.mjs"
  },
  "devDependencies": {
    "vite": "^7.1.0"
  }
}
