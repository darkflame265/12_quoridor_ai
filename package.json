{
  "name": "quoridor-ai",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "test": "node --test",
    "benchmark": "node scripts/benchmark.mjs",
    "evaluate": "node scripts/evaluate.mjs",
    "analyze-losses": "node scripts/analyze-losses.mjs",
    "wasm:build": "node scripts/build-wasm.mjs",
    "external:setup": "node scripts/setup-external.mjs",
    "train": "python training/train.py",
