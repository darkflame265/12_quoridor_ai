{
  "name": "quoridor-ai",
  "private": true,
  "type": "module",
  "scripts": {
    "play": "node scripts/play.mjs",
    "play:stop": "node scripts/play.mjs --stop",
    "play:shortcuts": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-play-shortcuts.ps1",
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "test": "node --test \"src/*.test.js\" scripts/play-lock.test.mjs",
    "screen:qa": "node scripts/check-screen-browser.mjs",
    "sigma:smoke": "node scripts/check-sigma-runtime.mjs"
  },
  "devDependencies": {
    "vite": "^7.1.0"
  }
}
